{
  "name": "coinxp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run typecheck --workspace client",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "perf:analytics": "npm run perf:analytics --workspace server",
    "gamification:adjust": "npm run gamification:adjust --workspace server --",
    "gamification:reconcile": "npm run gamification:reconcile --workspace server --",
    "gamification:rebuild-cache": "npm run gamification:rebuild-cache --workspace server --",
    "gamification:requeue-dead": "npm run gamification:requeue-dead --workspace server --",
    "integrity": "npm run integrity --workspace server --",
    "rewards": "npm run rewards --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2"
  }
}
